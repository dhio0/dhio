# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables.

# Postgres connection string (Neon from Vercel Storage sets this for you).
# Without it the site shows the static content in src/lib/data.ts and the admin is off.
DATABASE_URL=

# Admin login. Make the hash at http://localhost:3000/admin/setup (or: npm run admin:hash).
ADMIN_PASSWORD_HASH=

# Optional: key for signing the admin session cookie (32+ characters).
# When empty it is derived from ADMIN_PASSWORD_HASH.
SESSION_SECRET=

# Vercel Blob for certificate/screenshot uploads. Connecting a Blob store in
# Vercel Storage sets one of these: newer stores use BLOB_STORE_ID (with
# Vercel's OIDC token, automatic on Vercel), older ones BLOB_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
