# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables.

# Postgres connection string (Neon from Vercel Storage sets this for you).
# Without it the site shows the static content in src/lib/data.ts and the admin is off.
DATABASE_URL=

# Admin login. Create the hash with: npm run admin:hash
ADMIN_PASSWORD_HASH=

# Random string, at least 32 characters, used to sign the admin session cookie.
SESSION_SECRET=

# Vercel Blob token for certificate/screenshot uploads (Vercel Storage sets this).
BLOB_READ_WRITE_TOKEN=
